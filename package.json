{
  "name": "unflare-voice-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch src/server.ts",
    "build": "npm run build:api && npm run build:web",
    "build:web": "next build",
    "build:api": "tsc -p tsconfig.server.json",
    "start": "concurrently -k -n web,api -c cyan,green \"next start\" \"node dist/src/server.js\"",
    "test": "NODE_ENV=test tsx --test src/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@fastify/formbody": "latest",
    "@fastify/websocket": "latest",
    "@runware/sdk": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "next": "^16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "twilio": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "tsx": "latest",
    "typescript": "^5.9.3"
  }
}
