# Public HTTPS origin provided by ngrok, Cloudflare Tunnel, or your host.
# Twilio must be able to reach it and the derived wss:// URL.
PUBLIC_BASE_URL=https://your-public-host.example
PORT=3001
# Next.js runs at http://localhost:3000 and proxies browser API requests here.
API_ORIGIN=http://localhost:3001

RUNWARE_API_KEY=
RUNWARE_MODEL=deepseek:v4@flash

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+44XXXXXXXXXX
# Optional default recipient for the demo phone-call flow. This is never sent to the browser.
DEMO_PHONE_NUMBER=

# Twilio WhatsApp Sandbox sender, or your registered WhatsApp sender.
# The shared Sandbox sender is usually whatsapp:+14155238886; copy the value
# shown in your Twilio Console.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Development-only convenience. Leave false in any deployed environment.
SKIP_TWILIO_SIGNATURE_VALIDATION=false
EMERGENCY_NUMBER=999
